{
  "name": "ereborcodeforge/durin-presets",
  "description": "Architecture presets and project-shape policies for Durin.",
  "type": "library",
  "license": "MIT",
  "version": "0.1.1",
  "authors": [
    {
      "name": "Thales Ruppenthal",
      "email": "thales.rup@gmail.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "ereborcodeforge/durin-core": "^0.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../durin-core",
      "options": {
        "symlink": true
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "EreborCodeForge\\Durin\\Presets\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EreborCodeForge\\Durin\\Presets\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  }
}
